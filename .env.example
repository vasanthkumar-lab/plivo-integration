# ---------------------------------------------------------------------------
# Copy to .env in this folder. The API loads it automatically (repo-root .env
# first, then apps/api/.env if present). .env is gitignored.
#
# Leave AUTH_ID / AUTH_TOKEN empty to run in SIMULATOR MODE (no Plivo account
# needed). Fill them in to switch to LIVE calling.
# ---------------------------------------------------------------------------

# From the Plivo console dashboard. The moment both are set, the app switches
# to live WebRTC calling. These must never reach the browser.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# The Plivo number you own. Shown as caller ID on outbound calls, and the
# number customers dial to reach you.
PLIVO_PHONE_NUMBER=+918031770725

# Public base URL of this backend. Plivo must be able to POST to it from the
# internet, so localhost will NOT work for live calls.
#   1. ngrok http 4000
#   2. paste the https URL here
#   3. npm run plivo:setup -- <that same https URL>
# Answer URL = <this>/plivo/answer     Hangup URL = <this>/plivo/hangup
PUBLIC_BASE_URL=http://localhost:4000

# Phone that the "Vasanth (test line)" lead dials, so you can ring your own
# handset to prove the integration end to end.
TEST_PHONE_NUMBER=+919361778524

# Force SIMULATOR mode while keeping your credentials in place. Handy for
# demoing offline, or on a flaky network.
PLIVO_FORCE_SIMULATOR=false

# Record calls. Recording is started through Plivo's Record API once the
# call connects (<Dial> has no recording attributes).
PLIVO_RECORD=true

# Max recording length in seconds. Plivo defaults to 60, which truncates any
# call longer than a minute. Plivo allows up to 24 hours.
PLIVO_RECORD_MAX_SECONDS=7200

# JWT validity in seconds. Plivo recommends about 5 minutes.
PLIVO_TOKEN_TTL=300

# Name of the Plivo Application created by `npm run plivo:setup`.
PLIVO_APP_NAME=Hyring Sales CRM

PORT=4000

# ---------------------------------------------------------------- Deepgram
# Speech-to-text for call recordings. Get a key at https://console.deepgram.com
# Without it the app still records calls; transcripts are simply disabled.
DEEPGRAM_API_KEY=

# nova-3 is Deepgram's current best general model.
DEEPGRAM_MODEL=nova-3

# 'en' is safe. Use 'multi' when calls switch between English and an Indian
# language mid-sentence - nova-3 handles code-switching.
DEEPGRAM_LANGUAGE=en

# Transcribe automatically as soon as a recording arrives.
DEEPGRAM_AUTO=true

# 'dual' puts each call leg on its own audio channel, which lets Deepgram label
# speakers from the channel split instead of guessing by voice. Falls back to
# mono automatically if Plivo refuses.
PLIVO_RECORD_CHANNELS=stereo

# --------------------------------------------------------------- Postgres
# Leave blank to use the JSON store at apps/api/.data/crm.json instead.
DATABASE_URL=postgres://postgres:root@localhost:5433/pivlo

# ---------------------------------------------------------------- Gemini
# AI analysis of call transcripts: did the lead convert?
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_AUTO=true
